{
  "id": null,
  "uid": "mimic-mlops",
  "title": "MIMIC MLOps - Production Monitoring",
  "tags": ["mlops", "mimic", "production"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "10s",
  "panels": [

    {
      "type": "stat",
      "title": "Requests per Second",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "rate(api_request_count_total[1m])",
          "legendFormat": "RPS"
        }
      ]
    },

    {
      "type": "stat",
      "title": "Prediction Rate",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "rate(model_prediction_total[1m])",
          "legendFormat": "Pred/sec"
        }
      ]
    },

    {
      "type": "stat",
      "title": "API Errors",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "rate(model_errors_total[1m])",
          "legendFormat": "Errors/sec"
        }
      ]
    },

    {
      "type": "stat",
      "title": "Average Prediction Probability",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "avg_over_time(model_prediction_total[5m])",
          "legendFormat": "Avg Confidence"
        }
      ]
    },

    {
      "type": "stat",
      "title": "CPU Usage (%)",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "system_cpu_usage_percent",
          "legendFormat": "CPU %"
        }
      ]
    },

    {
      "type": "stat",
      "title": "Memory Usage (%)",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "system_memory_usage_percent",
          "legendFormat": "RAM %"
        }
      ]
    },

    {
      "type": "stat",
      "title": "p95 Latency (seconds)",
      "gridPos": { "x": 0, "y": 4, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(api_request_latency_seconds_bucket[5m]))",
          "legendFormat": "p95"
        }
      ]
    },

    {
      "type": "stat",
      "title": "Champion vs Challenger Traffic",
      "gridPos": { "x": 6, "y": 4, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "model_version_served_total",
          "legendFormat": "{{version}}"
        }
      ]
    },

    {
      "type": "stat",
      "title": "Drift Indicator (PSI Placeholder)",
      "gridPos": { "x": 12, "y": 4, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "0",
          "legendFormat": "PSI"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "API Latency Trend",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "rate(api_request_latency_seconds_sum[1m]) / rate(api_request_latency_seconds_count[1m])",
          "legendFormat": "Avg Latency"
        }
      ]
    }

  ]
}
